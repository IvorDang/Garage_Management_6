skinparam nodesep 20
skinparam ranksep 40
actor "Customer" as KH
rectangle "<<boundary>>\nGDChinhKH6" as GDC
rectangle "<<boundary>>\nGDTimKiem6" as GDT
rectangle "<<boundary>>\nGDChiTiet6" as GDCT
