@startuml 14_ThietKe_Module2
!include _style.iuml
hide circle
skinparam nodesep 25
skinparam ranksep 45
package "View (JSP)" {
  class "gdChinhQL6.jsp" as A {
    -subXemThongKe : link
    -ql : ManagementStaff6
  }
  class "gdChonThongKe6.jsp" as B {
    -inLoaiTK : Select
    -inTuNgay : Date
    -inDenNgay : Date
    -subTimKiem : submit
    -subQuayLai : button
  }
  class "gdKetQuaThongKe6.jsp" as C {
    -tblKhachHang : Table
    -chonKH : link
    -subQuayLai : button
    -listTK : List<CustomerStatistic6>
  }
  class "gdDSHoaDon6.jsp" as D {
    -tblHoaDon : Table
    -chonHD : link
    -subQuayLai : button
    -listInvoice : List<Invoice6>
  }
  class "gdChiTietHoaDon6.jsp" as E {
    -outThongTinChung : text
    -tblChiTietDichVu : Table
    -tblChiTietPhuTung : Table
    -subQuayLai : button
    -invoice : Invoice6
  }
}

  class DAO6 {
    #con : Connection
  }
  class CustomerStatisticDAO6 {
    +getCustomerStatistic(startDate, endDate)\n  : List<CustomerStatistic6>
  }
  class InvoiceDAO6 {
    +getInvoicesByCustomer(customerId,\n  startDate, endDate) : List<Invoice6>
    +getInvoiceDetail(invoiceId : int)\n  : Invoice6
  }
package "Model (Entity)" {
  class SystemMember6 {
    -id : int
    -name : String
    -phone : String
    -email : String
  }
  class Customer6 {
    -customerCode : String
  }
  class CustomerStatistic6 {
    -totalRevenue : float
    -startDate : Date
    -endDate : Date
  }
  class Vehicle6 {
    -licensePlate : String
    -customer : Customer6
  }
  class Reception6 {
    -receptionCode : String
    -vehicle : Vehicle6
  }
  class Invoice6 {
    -id : int
    -invoiceCode : String
    -createdDate : Date
    -totalAmount : float
    -reception : Reception6
    -serviceDetails : List<ServiceDetail6>
    -sparePartDetails : List<SparePartDetail6>
  }
  class ServiceDetail6 {
    -quantity : int
    -unitPrice : float
    -subTotal : float
    -service : Service6
    -technicalStaff : TechnicalStaff6
  }
  class SparePartDetail6 {
    -quantity : int
    -unitPrice : float
    -subTotal : float
    -sparePart : SparePart6
  }
  class Service6 {
    -serviceCode : String
    -name : String
  }
  class SparePart6 {
    -partCode : String
    -name : String
  }
  class TechnicalStaff6 {
    -staffCode : String
  }
}
A .right.> B : calls
B .right.> C : calls
C .down.> D : calls
D .left.> E : calls
C -down-> CustomerStatisticDAO6 : uses >
D -down-> InvoiceDAO6 : uses >
E -down-> InvoiceDAO6 : uses >
DAO6 <|-- CustomerStatisticDAO6
DAO6 <|-- InvoiceDAO6
CustomerStatisticDAO6 ..> CustomerStatistic6 : <<creates>>
InvoiceDAO6 ..> Invoice6 : <<creates>>
SystemMember6 <|-- Customer6
Customer6 <|-- CustomerStatistic6
Vehicle6 "0..*" o-down- "1" Customer6
Reception6 "0..*" o-- "1" Vehicle6
Invoice6 "0..1" o-- "1" Reception6
Invoice6 "1" *-- "1..*" ServiceDetail6
Invoice6 "1" *-- "0..*" SparePartDetail6
ServiceDetail6 "0..*" o-- "1" Service6
ServiceDetail6 "0..*" o-- "1" TechnicalStaff6
SparePartDetail6 "0..*" o-- "1" SparePart6
@enduml
